@using Archetypical.Software.SchemaRegistry.Shared.Enums
@model List<Archetypical.Software.SchemaRegistry.Models.HomeViewModel>
@{ ViewData["Title"] = "Schema Collections"; }



<div class="flex flex-col">
    <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
            @if (!Model.Any())
            {
                <button type="button"  onclick="ToggleModal()" class="z-50 relative block w-full rounded-lg border-2 border-dashed border-gray-300 p-12 text-center hover:border-gray-400 focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:outline-hidden">
                    <svg class="mx-auto size-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v20c0 4.418 7.163 8 16 8 1.381 0 2.721-.087 4-.252M8 14c0 4.418 7.163 8 16 8s16-3.582 16-8M8 14c0-4.418 7.163-8 16-8s16 3.582 16 8m0 0v14m0-4c0 4.418-7.163 8-16 8S8 28.418 8 24m32 10v6m0 0v6m0-6h6m-6 0h-6" />
                    </svg>
                    <span class="mt-2 block text-sm font-semibold text-gray-900">Create a new Schema Collection</span>
                </button>
                <div class="relative z-10 ease-out duration-300 opacity-0" aria-labelledby="modal-title" role="dialog" id="backdrop" data-state="hidden" aria-modal="true">
                    <!--
                      Background backdrop, show/hide based on modal state.

                      Entering: "ease-out duration-300"
                        From: "opacity-0"
                        To: "opacity-100"
                      Leaving: "ease-in duration-200"
                        From: "opacity-100"
                        To: "opacity-0"
                    -->
                    <div class="fixed inset-0 bg-gray-500/75 transition-opacity" aria-hidden="true"></div>

                    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
                        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0" id="modal" data-state="hidden">
                            
                            <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pt-5 pb-4 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-sm sm:p-6">
                                <form>
                                    <div class="space-y-12 sm:space-y-16">
                                        <div>
                                            <h2 class="text-base/7 font-semibold text-gray-900">Schema Collection</h2>
                                            <p class="mt-1 max-w-2xl text-sm/6 text-gray-600">This is where you can group your schemas by domain, product or any other facet that you'd like</p>

                                            <div class="mt-10 space-y-8 border-b border-gray-900/10 pb-12 sm:space-y-0 sm:divide-y sm:divide-gray-900/10 sm:border-t sm:pb-0">
                                                <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6">
                                                    <label for="name" class="block text-sm/6 font-medium text-gray-900 sm:pt-1.5">Name</label>
                                                    <div class="mt-2 sm:col-span-2 sm:mt-0">
                                                        <div class="flex items-center rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-indigo-600 sm:max-w-md">
                                            
                                                            <input type="text" name="collection" id="collection" class="block min-w-0 grow py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6" placeholder="Product X's schemas">
                                                        </div>
                                                    </div>
                                                </div>

                                
                                            </div>
                                        </div>

                                    </div>

                                    <div class="mt-6 flex items-center justify-end gap-x-6">
                                        <button type="button" class="text-sm/6 font-semibold text-gray-900" onclick="ToggleModal()">Cancel</button>
                                        <button type="submit" onclick="CreateCollection()" class="inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Save</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                @section Scripts{
                    <script>
                    function ToggleModal(){
                        // find the modal and the background
                        const modal = document.getElementById("modal");
                        const backdrop = document.getElementById("backdrop");
                        const state = backdrop.dataset["state"];
                        if (state === "hidden"){
                            modal.dataset["state"] = "visible";
                            backdrop.dataset["state"] = "visible";

                            // Background backdrop, show/hide based on modal state.
                      // Entering: "ease-out duration-300"
                      //   From: "opacity-0"
                      //   To: "opacity-100"
                      // Leaving: "ease-in duration-200"
                      //   From: "opacity-100"
                      //   To: "opacity-0"

                            backdrop.classList.remove("ease-in","duration-200","opacity-0");
                            backdrop.classList.add("ease-out","duration-300","opacity-100")
                       
                              // Modal panel, show/hide based on modal state.

                              // Entering: "ease-out duration-300"
                              //   From: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                              //   To: "opacity-100 translate-y-0 sm:scale-100"
                              // Leaving: "ease-in duration-200"
                              //   From: "opacity-100 translate-y-0 sm:scale-100"
                              //   To: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"

                    modal.classList.remove("ease-in","duration-200","opacity-0","translate-y-4","sm:translate-y-0","sm:scale-95");
                    modal.classList.add("ease-out","duration-300","opacity-100","translate-y-0","sm:scale-100")

                        }else{
                            modal.dataset["state"] = "visible";
                            backdrop.dataset["state"] = "visible";

                            backdrop.classList.remove("ease-out","duration-300","opacity-100")
                            backdrop.classList.add("ease-in","duration-200","opacity-0");

                            modal.classList.remove("ease-out","duration-300","opacity-100","translate-y-0","sm:scale-100")
                            modal.classList.add("ease-in","duration-200","opacity-0","translate-y-4","sm:translate-y-0","sm:scale-95");
                    
                        }
                    }
                    </script>

                    <script>
                        function CreateCollection(){
                            const name = document.getElementById("collection").value;
                            fetch('/api/collections', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({name: name})
                            })
                        }
                    </script>
                }

            }
            else
            {

            
            <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">

                <ul role="list" class="divide-y divide-gray-100">
                    @foreach (var vm in Model)
                    {
                        <li class="relative flex justify-between gap-x-6 py-5">
                            <div class="flex min-w-0 gap-x-4">
                                <img class="size-12 flex-none rounded-full bg-gray-50" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80" alt="">
                                <div class="min-w-0 flex-auto">
                                    <p class="text-sm/6 font-semibold text-gray-900">
                                        <a href="#">
                                            <span class="absolute inset-x-0 -top-px bottom-0"></span>
                                            @vm.Collection.Name
                                        </a>
                                    </p>
                                    <p class="mt-1 flex text-xs/5 text-gray-500">
                                        @vm.SchemaCount Schemas
                                    </p>
                                </div>
                            </div>
                            <div class="flex shrink-0 items-center gap-x-4">
                                <div class="hidden sm:flex sm:flex-col sm:items-end">
                                     
                                    <p class="mt-1 text-xs/5 text-gray-500">Last edited <time datetime="@vm.Collection.ModifiedTimeUtc">@((vm.Collection.ModifiedTimeUtc-DateTime.UtcNow).Days) days ago</time></p>
                                </div>
                                <svg class="size-5 flex-none text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                                    <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </li>
                    }
                </ul>
                </div>
            }
        </div>
    </div>
</div>